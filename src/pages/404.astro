---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | waxmy.hair | Premium Domain for Sale | Desert Rich" description="That page is not on waxmy.hair. The domain is still for sale." path="/404" noindex>
  <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <p class="text-accent">404</p>
    <h1 class="mt-2 font-display text-5xl">This page is not part of the sale</h1>
    <p class="mt-4 text-muted">The name is still available. Start from the front door.</p>
    <a href="/" class="mt-6 inline-flex min-h-12 items-center text-accent">Back to waxmy.hair</a>
  </div>
</BaseLayout>
