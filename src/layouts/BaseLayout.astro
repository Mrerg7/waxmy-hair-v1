---
import "../styles/global.css";
import { BRAND, DOMAIN, SALES, VERIFY, blankMailto, nav } from "../data";

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const og = new URL("/og.jpg", Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#9c4630" />
    <meta name="google-site-verification" content={VERIFY} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={DOMAIN} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("waxmy-theme");
          var d = t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches);
          if (d) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-3">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
        <a href="/" class="flex min-h-12 items-center gap-2 font-medium">
          <svg viewBox="0 0 32 32" class="size-10 shrink-0" aria-hidden="true">
            <rect width="32" height="32" rx="16" class="fill-ink"></rect>
            <path class="fill-accent" d="M16 3.6c.55.75 8 9.4 8 13.6a8 8 0 1 1-16 0C8 13 15.45 4.35 16 3.6z"></path>
          </svg>
          <span>{DOMAIN}</span>
        </a>
        <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} class="rounded-full px-3 py-3 text-muted hover:text-ink">{item.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2 lg:ml-3">
          <button type="button" data-theme class="grid size-12 place-items-center rounded-full border border-line bg-surface" aria-label="Switch theme">
            <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"/></svg>
            <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a href="/acquire" class="hidden min-h-12 items-center rounded-full bg-accent px-4 text-on-accent sm:inline-flex">Make an offer</a>
          <button type="button" data-menu class="grid size-12 place-items-center rounded-full border border-line bg-surface lg:hidden" aria-expanded="false" aria-label="Open menu">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav data-menu-panel hidden class="border-t border-line px-4 py-3 lg:hidden" aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} class="flex min-h-12 items-center">{item.label}</a>
        ))}
        <a href="/acquire" class="mt-2 flex min-h-12 items-center justify-center rounded-full bg-accent px-4 text-on-accent">Make an offer</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
        <div>
          <p class="font-display text-2xl">{DOMAIN}</p>
          <p class="mt-2 max-w-xs text-muted">A single premium .hair name, offered by {BRAND}. Not a salon. Not a marketplace.</p>
        </div>
        <div>
          <p class="font-medium">Pages</p>
          <ul class="mt-3">
            {nav.map((item) => (
              <li><a class="inline-flex min-h-12 items-center text-muted hover:text-ink" href={item.href}>{item.label}</a></li>
            ))}
            <li><a class="inline-flex min-h-12 items-center text-muted hover:text-ink" href="/acquire">Acquire</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium">Desk</p>
          <a class="mt-3 inline-flex min-h-12 items-center text-accent" href={blankMailto}>{SALES}</a>
          <p class="text-muted">Price on request. Escrow welcome.</p>
        </div>
      </div>
      <p class="mx-auto max-w-6xl border-t border-line px-4 py-6 text-muted sm:px-6">
        {DOMAIN} is offered for acquisition only. Owning the name does not include a website, leads, a license, or a ranking. © {year} {BRAND}.
      </p>
    </footer>
    <div data-exit hidden class="fixed inset-0 z-50 grid place-items-end bg-ink/40 p-4 sm:place-items-center">
      <div role="dialog" aria-modal="true" aria-labelledby="exit-title" class="w-full max-w-md rounded-3xl border border-line bg-surface p-6">
        <p class="text-accent">Before you go</p>
        <h2 id="exit-title" class="mt-2 font-display text-3xl">Ask for the range</h2>
        <p class="mt-2 text-muted">One email. No list. Your mail app opens a draft to the desk.</p>
        <form data-offer data-subject="Range request - waxmy.hair" class="mt-5 grid gap-3">
          <label class="grid gap-1">Email
            <input required type="email" name="email" autocomplete="email" class="min-h-12 rounded-2xl border border-line bg-bg px-3" />
          </label>
          <button type="submit" class="min-h-12 rounded-full bg-accent px-4 text-on-accent">Email {SALES}</button>
          <button type="button" data-exit-close class="min-h-12 text-muted">Keep browsing</button>
        </form>
      </div>
    </div>
    <script src="/site.js" defer></script>
  </body>
</html>
